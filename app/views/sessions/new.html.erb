<% content_for :title, t(".title") %>
<section class="mx-auto max-w-sm py-10">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <p class="mt-2 text-gray-600"><%= t(".intro") %></p>
  <%= form_with url: session_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :phone, t(".phone"), class: "block text-sm font-medium" %>
      <%= form.telephone_field :phone, value: @phone, required: true, autofocus: true, autocomplete: "tel", inputmode: "tel",
            placeholder: "+374 91 123456", class: "mt-1 block w-full rounded-lg border px-3 py-2 text-lg" %>
    </div>
    <%= form.submit t(".submit"), class: "w-full rounded-lg bg-yellow-400 px-4 py-2 text-lg font-semibold text-gray-900" %>
  <% end %>
  <p class="mt-4 text-xs text-gray-500"><%= t(".terms") %></p>
</section>
