<%# locals: (trip:) %>
<%# Re-rendered by Notify.trip over Turbo Streams, so it uses nothing but the trip itself. %>
<div id="trip_status" class="rounded-xl border p-4" data-status="<%= trip.status %>">
  <p class="text-lg font-semibold"><%= t("trips.status.title.#{trip.status}") %></p>
  <p class="mt-1 text-gray-600"><%= t("trips.status.body.#{trip.status}", default: "") %></p>

  <% if trip.driver_profile && trip.status.in?(Trip::BUSY) %>
    <% vehicle = trip.vehicle %>
    <div class="mt-3 flex items-center justify-between gap-3 rounded-lg bg-gray-50 p-3">
      <div>
        <p class="font-medium"><%= trip.driver.name %></p>
        <p class="text-sm text-gray-600"><%= vehicle&.description %></p>
      </div>
      <p class="rounded border-2 border-gray-900 px-2 py-0.5 font-mono font-bold whitespace-nowrap"><%= vehicle&.plate_number %></p>
    </div>
    <% if trip.accepted? && (eta = trip.offers.accepted.pick(:eta_s)) %>
      <p class="mt-2 text-sm"><%= t("trips.status.eta", minutes: [ (eta / 60.0).ceil, 1 ].max) %></p>
    <% end %>
  <% end %>

  <% if trip.status.in?(%w[ accepted arrived in_progress completed ]) %>
    <p class="mt-3 font-medium"><%= t("payments.trip.pay_cash", fare: amd(trip.fare)) %></p>
  <% end %>
  <% if trip.outstanding_fee.positive? %>
    <p class="mt-1 text-sm text-gray-600"><%= t("payments.trip.includes_fee", fee: amd(trip.outstanding_fee)) %></p>
  <% end %>
  <p class="mt-3 text-sm text-gray-600">
    <%= t("trips.status.fare", fare: amd(trip.fare), vehicle_class: t("vehicles.classes.#{trip.vehicle_class}")) %>
    <% if trip.cancellation_fee.positive? %> · <%= t("trips.status.cancellation_fee", fee: amd(trip.cancellation_fee)) %><% end %>
  </p>
  <% if trip.no_drivers? || trip.cancelled? || trip.completed? %>
    <a href="/ride/new" class="mt-3 inline-block rounded-lg bg-yellow-400 px-4 py-2 font-semibold text-gray-900"><%= t("trips.status.again") %></a>
  <% end %>
</div>
