<h1 class="font-bold text-4xl">Where are you?</h1>

<%= form_with model: profile, url: onboarding_path("about"), method: :patch do |form| %>
  <%= render "shared/errors", record: profile %>
  <%= render "profiles/about_fields", form: form %>
  <%= form.submit "Continue", class: primary_button_classes %>
<% end %>
