<div class="flex items-center justify-between">
  <h1 class="font-bold text-4xl">Live now</h1>
  <%= link_to "Go live", go_live_path, class: primary_button_classes %>
</div>

<% if @streams.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
    <% @streams.each do |stream| %>
      <%= render "streams/card", stream: stream %>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-600 mt-6">Nobody is live right now. Be the first: <%= link_to "go live", go_live_path, class: "underline" %>!</p>
<% end %>
