<% profile = stream.user.profile %>
<%= link_to stream_path(stream), id: dom_id(stream, :card), class: "block rounded-xl overflow-hidden shadow bg-white" do %>
  <div class="relative">
    <% if (photo = profile.main_photo) %>
      <%= image_tag photo.image.variant(:card), alt: profile.display_name, class: "w-full aspect-video object-cover" %>
    <% else %>
      <div class="w-full aspect-video bg-gray-800"></div>
    <% end %>
    <%= live_badge("absolute top-2 left-2") %>
    <span class="absolute top-2 right-2 rounded bg-black/60 text-white text-xs px-2 py-0.5">👁 <%= stream.viewers_count %></span>
  </div>
  <div class="p-3">
    <p class="font-semibold truncate"><%= stream.title %></p>
    <p class="text-sm text-gray-500"><%= profile.display_name %> · <%= stream.category.humanize %></p>
  </div>
<% end %>
