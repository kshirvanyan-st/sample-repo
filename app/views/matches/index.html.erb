<h1 class="font-bold text-4xl">Matches</h1>

<% if @matches.any? %>
  <div class="flex flex-wrap gap-6 mt-6">
    <% @matches.each do |match| %>
      <% profile = match.other(Current.user).profile %>
      <div id="<%= dom_id(match) %>">
        <%= render "profiles/card", profile: profile %>
        <div class="flex gap-3 mt-2 text-sm items-center">
          <span class="text-gray-500">Matched <%= time_ago_in_words(match.created_at) %> ago</span>
          <%= button_to "Unmatch", match_path(match), method: :delete, class: "underline text-red-600 cursor-pointer", form: { data: { turbo_confirm: "Unmatch #{profile.display_name}?" } } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-600 mt-4">No matches yet. When someone you like likes you back, they'll show up here.</p>
<% end %>
