<%# Top bar on every screen; the main links move to a bottom tab bar on phones. %>
<nav class="fixed top-0 inset-x-0 bg-white border-b z-10">
  <div class="container mx-auto px-5 h-14 flex items-center gap-5 text-sm font-medium whitespace-nowrap">
    <%= link_to "Spark", root_path, class: "text-pink-600 font-bold text-lg mr-2" %>
    <div class="hidden sm:flex items-center gap-5">
      <%= link_to "Discover", discover_path %>
      <%= link_to liked_me_path do %>
        Liked me <span class="liked-me-count ml-1 rounded-full bg-pink-100 text-pink-700 px-2"><%= liked_me_count %></span>
      <% end %>
      <%= link_to matches_path do %>
        Matches <span class="matches-count ml-1 rounded-full bg-gray-100 px-2"><%= Current.user.matches.count %></span>
      <% end %>
    </div>
    <%= link_to "Profile", profile_path(Current.user.profile), class: "ml-auto hidden sm:inline" %>
    <%= button_to "Sign out", session_path, method: :delete, form_class: "ml-auto sm:ml-0", class: "text-gray-500 cursor-pointer" %>
  </div>
</nav>

<nav class="sm:hidden fixed bottom-0 inset-x-0 bg-white border-t z-10" aria-label="Main">
  <div class="grid grid-cols-4 h-16 text-xs font-medium text-center">
    <%= link_to discover_path, class: "flex flex-col items-center justify-center gap-1" do %>
      <span class="text-lg leading-none">♥</span>Discover
    <% end %>
    <%= link_to liked_me_path, class: "flex flex-col items-center justify-center gap-1" do %>
      <span class="liked-me-count rounded-full bg-pink-100 text-pink-700 px-2 leading-5"><%= liked_me_count %></span>Liked me
    <% end %>
    <%= link_to matches_path, class: "flex flex-col items-center justify-center gap-1" do %>
      <span class="matches-count rounded-full bg-gray-100 px-2 leading-5"><%= Current.user.matches.count %></span>Matches
    <% end %>
    <%= link_to profile_path(Current.user.profile), class: "flex flex-col items-center justify-center gap-1" do %>
      <span class="text-lg leading-none">☺</span>Profile
    <% end %>
  </div>
</nav>
