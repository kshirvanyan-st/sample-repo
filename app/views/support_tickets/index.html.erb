<% content_for :title, t(".title") %>
<section class="mx-auto max-w-lg py-10">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <%= link_to t(".new"), new_support_ticket_path, class: "mt-4 inline-block rounded-lg bg-yellow-400 px-4 py-2 font-medium text-gray-900" %>
  <ul class="mt-6 divide-y rounded-xl border">
    <% @tickets.each do |ticket| %>
      <li class="p-4">
        <%= link_to support_ticket_path(ticket), class: "flex justify-between gap-3" do %>
          <span class="font-medium"><%= t("support.kinds.#{ticket.kind}") %> #<%= ticket.id %></span>
          <span class="text-sm text-gray-600"><%= t("support.statuses.#{ticket.status}") %> · <%= l(ticket.updated_at, format: :short) %></span>
        <% end %>
      </li>
    <% end %>
    <% if @tickets.empty? %><li class="p-4 text-gray-600"><%= t(".none") %></li><% end %>
  </ul>
</section>
