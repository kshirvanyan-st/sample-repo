<div class="mx-auto md:w-2/3 w-full">
  <div class="flex items-end justify-between">
    <div>
      <h1 class="font-bold text-4xl">Coins</h1>
      <p class="text-gray-600 mt-1">Send gifts to people when they're live.</p>
    </div>
    <p class="text-3xl font-bold">🪙 <span class="coin-balance"><%= Current.user.coin_balance %></span></p>
  </div>

  <% if @purchase&.pending? %>
    <p class="mt-6 rounded-lg bg-yellow-50 text-yellow-800 px-3 py-2">Payment received, your coins will appear in a moment.</p>
  <% elsif @purchase&.paid? %>
    <p class="mt-6 rounded-lg bg-green-50 text-green-700 px-3 py-2"><%= @purchase.coins %> coins added. Enjoy!</p>
  <% end %>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
    <% @coin_packs.each do |pack| %>
      <%= button_to purchases_path, params: { coin_pack_id: pack.id }, class: "w-full h-full rounded-xl border p-4 text-left hover:border-pink-500 cursor-pointer bg-white", data: { turbo: false } do %>
        <p class="text-2xl font-bold">🪙 <%= pack.total_coins %></p>
        <% if pack.bonus_coins.positive? %><p class="text-sm text-green-700">+<%= pack.bonus_coins %> bonus</p><% end %>
        <p class="text-sm text-gray-500 mt-1"><%= pack.name %></p>
        <p class="font-semibold mt-3"><%= number_to_currency(pack.price, unit: pack.currency == "eur" ? "€" : "$") %></p>
      <% end %>
    <% end %>
  </div>
  <p class="text-xs text-gray-400 mt-3">Payments are processed securely by Stripe. Coins are non-refundable once spent.</p>

  <h2 class="font-semibold text-xl mt-10">History</h2>
  <% if @entries.any? %>
    <ul class="mt-3 divide-y border rounded-xl bg-white">
      <% @entries.each do |entry| %>
        <li class="flex justify-between p-3 text-sm">
          <span><%= ledger_description(entry) %> <span class="text-gray-400 ml-2"><%= time_ago_in_words(entry.created_at) %> ago</span></span>
          <span class="<%= entry.amount.positive? ? "text-green-700" : "text-gray-700" %> font-medium"><%= format("%+d", entry.amount) %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 mt-2">No coin activity yet.</p>
  <% end %>
</div>
