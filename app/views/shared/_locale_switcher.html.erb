<nav aria-label="<%= t("shared.locale_switcher.label") %>" class="flex gap-3 text-sm">
  <% { hy: "Հայերեն", ru: "Русский", en: "English" }.each do |locale, name| %>
    <%= link_to name, (request.get? ? url_for(locale: locale) : root_path(locale: locale)), lang: locale, data: { turbo_prefetch: false }, class: I18n.locale == locale ? "font-bold underline" : "text-gray-600",
          aria: { current: (I18n.locale == locale ? "true" : nil) } %>
  <% end %>
</nav>
