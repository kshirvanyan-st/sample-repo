<% content_for :title, t(".title") %>
<section class="py-6">
  <%= render "admin/shared/tabs" %>
  <h1 class="mt-6 text-2xl font-bold"><%= t(".title") %></h1>
  <p class="mt-1 text-gray-600"><%= t(".intro") %></p>
  <div class="mt-6 space-y-6">
    <% @tariffs.each do |tariff| %>
      <%= form_with model: [ :admin, tariff ], class: "rounded-xl border p-4", id: dom_id(tariff) do |form| %>
        <h2 class="text-lg font-semibold"><%= t("vehicles.classes.#{tariff.vehicle_class}") %></h2>
        <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
          <% Tariff::AMOUNTS.each do |amount| %>
            <div>
              <%= form.label amount, class: "block text-sm font-medium" %>
              <%= form.number_field amount, min: 0, step: 10, required: true, class: "mt-1 block w-full rounded-lg border px-3 py-2" %>
            </div>
          <% end %>
          <div>
            <%= form.label :cancellation_fee, class: "block text-sm font-medium" %>
            <%= form.number_field :cancellation_fee, min: 0, step: 10, required: true, class: "mt-1 block w-full rounded-lg border px-3 py-2" %>
          </div>
          <div>
            <%= form.label :free_cancellation_minutes, class: "block text-sm font-medium" %>
            <%= form.number_field :free_cancellation_minutes, min: 0, max: 30, required: true, class: "mt-1 block w-full rounded-lg border px-3 py-2" %>
          </div>
        </div>
        <p class="mt-3 text-sm text-gray-600">
          <%= t(".example", price: amd(tariff.fare_for(distance_m: 5000, duration_s: 900))) %>
          <% if tariff.updated_by %> · <%= t(".updated", name: tariff.updated_by.display_name, time: l(tariff.updated_at, format: :short)) %><% end %>
        </p>
        <%= form.submit t(".save"), class: "mt-3 rounded-lg bg-yellow-400 px-4 py-2 font-medium text-gray-900" %>
      <% end %>
    <% end %>
  </div>
</section>
