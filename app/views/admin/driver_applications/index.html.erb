<% content_for :title, t(".title") %>
<section class="py-6">
  <%= render "admin/shared/tabs" %>
  <h1 class="mt-6 text-2xl font-bold"><%= t(".title") %></h1>
  <nav class="mt-4 flex flex-wrap gap-2 text-sm" aria-label="<%= t(".filter") %>">
    <% Admin::DriverApplicationsController::STATUSES.each do |status| %>
      <%= link_to admin_driver_applications_path(status: status),
            class: "rounded-full border px-3 py-1 #{'bg-gray-900 text-white' if status == @status}",
            aria: { current: (status == @status ? "page" : nil) } do %>
        <%= t("driver_profiles.statuses.#{status}") %> (<%= @counts.fetch(status, 0) %>)
      <% end %>
    <% end %>
  </nav>

  <% if @driver_profiles.empty? %>
    <p class="mt-8 text-gray-600"><%= t(".empty") %></p>
  <% else %>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b text-gray-600">
          <tr>
            <th class="py-2 pr-4"><%= User.human_attribute_name(:name) %></th>
            <th class="py-2 pr-4"><%= User.human_attribute_name(:phone) %></th>
            <th class="py-2 pr-4"><%= t(".vehicle") %></th>
            <th class="py-2 pr-4"><%= DriverProfile.human_attribute_name(:submitted_at) %></th>
            <th class="py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% @driver_profiles.each do |profile| %>
            <tr class="border-b" id="<%= dom_id(profile) %>">
              <td class="py-2 pr-4"><%= profile.user.name %></td>
              <td class="py-2 pr-4 whitespace-nowrap"><%= profile.user.display_phone %></td>
              <td class="py-2 pr-4"><%= profile.vehicle&.description %> <span class="whitespace-nowrap text-gray-600"><%= profile.vehicle&.plate_number %></span></td>
              <td class="py-2 pr-4 whitespace-nowrap"><%= profile.submitted_at && l(profile.submitted_at, format: :short) %></td>
              <td class="py-2"><%= link_to t(".review"), admin_driver_application_path(profile), class: "underline" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
