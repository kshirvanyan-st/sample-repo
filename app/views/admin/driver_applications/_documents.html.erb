<%# locals: (record:) %>
<div class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4">
  <% record.class::DOCUMENTS.each do |name| %>
    <figure class="rounded-lg border p-2">
      <figcaption class="text-xs font-medium text-gray-600"><%= record.class.human_attribute_name(name) %></figcaption>
      <% if (file = record.public_send(name)).attached? %>
        <% if file.image? && file.content_type != "image/heic" && file.content_type != "image/heif" %>
          <%= link_to document_path(file.attachment), target: "_blank" do %>
            <%= image_tag document_path(file.attachment), alt: record.class.human_attribute_name(name), class: "mt-2 h-32 w-full rounded object-cover" %>
          <% end %>
        <% else %>
          <%= link_to file.filename.to_s.truncate(24), document_path(file.attachment), target: "_blank", class: "mt-2 block text-sm underline" %>
        <% end %>
      <% else %>
        <p class="mt-2 text-sm text-red-700"><%= t("admin.driver_applications.show.missing") %></p>
      <% end %>
    </figure>
  <% end %>
</div>
