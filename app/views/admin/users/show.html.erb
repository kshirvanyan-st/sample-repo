<% profile = @user.profile %>
<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="font-bold text-3xl"><%= profile&.display_name || @user.email_address %></h1>
    <p class="text-gray-500"><%= @user.email_address %> · <%= @user.role %> · joined <%= l(@user.created_at.to_date, format: :long) %>
      <% if profile %> · <%= link_to "public profile", profile_path(profile), class: "underline" %><% end %></p>
    <p class="text-sm text-gray-500 mt-1">🪙 <%= @user.coin_balance %> coins · <%= @user.earnings_balance %> earned</p>
  </div>
  <% if @user.banned? %>
    <div class="rounded-lg bg-red-50 text-red-700 px-3 py-2">Banned <%= time_ago_in_words(@user.banned_at) %> ago: <%= @user.ban_reason %></div>
  <% end %>
</div>

<div class="grid md:grid-cols-3 gap-6 mt-6">
  <section class="md:col-span-2 space-y-6">
    <div>
      <h2 class="font-semibold text-lg">Photos</h2>
      <div class="grid grid-cols-3 md:grid-cols-5 gap-3 mt-2">
        <% @photos.each do |photo| %>
          <%= render "admin/photos/photo", photo: photo %>
        <% end %>
      </div>
      <% if profile&.bio.present? %><p class="mt-3 text-gray-700">Bio: “<%= profile.bio %>”</p><% end %>
    </div>

    <div>
      <h2 class="font-semibold text-lg">Reports against them (<%= @reports.size %>)</h2>
      <ul class="mt-2 divide-y text-sm">
        <% @reports.each do |report| %>
          <li class="py-2"><span class="font-medium"><%= report.reason.humanize %></span> by <%= report.reporter.email_address %> · <%= report.status %>
            <% if report.details.present? %> · “<%= report.details %>”<% end %></li>
        <% end %>
      </ul>
    </div>

    <div>
      <h2 class="font-semibold text-lg">Streams</h2>
      <ul class="mt-2 divide-y text-sm">
        <% @streams.each do |stream| %>
          <li class="py-2 flex justify-between"><span><%= stream.title %> · <%= stream.status %> · peak <%= stream.peak_viewers %></span>
            <% if stream.live? %><%= link_to "Watch", stream_path(stream), class: "underline" %><% end %></li>
        <% end %>
      </ul>
    </div>
  </section>

  <aside class="space-y-4">
    <% unless @user == Current.user %>
      <div class="rounded-xl border bg-white p-4 space-y-3">
        <h2 class="font-semibold">Actions</h2>
        <% if @user.banned? %>
          <%= button_to "Unban", unban_admin_user_path(@user), class: secondary_button_classes %>
        <% elsif !@user.staff? %>
          <%= form_with url: ban_admin_user_path(@user), class: "space-y-2", data: { turbo_confirm: "Ban this user? They'll be signed out everywhere." } do |form| %>
            <%= form.text_field :reason, required: true, placeholder: "Reason (shown in the audit log)", aria: { label: "Ban reason" }, class: "#{input_classes} mt-0" %>
            <%= form.submit "Ban user", class: "rounded-md px-3.5 py-2 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer" %>
          <% end %>
        <% end %>
        <% if @user.streaming_suspended? %>
          <%= button_to "Allow streaming again", restore_streaming_admin_user_path(@user), class: secondary_button_classes %>
        <% end %>
        <% if Current.user.admin? %>
          <%= form_with url: role_admin_user_path(@user), method: :patch, class: "flex gap-2" do |form| %>
            <%= form.select :role, User.roles.keys, { selected: @user.role }, aria: { label: "Role" }, class: "#{input_classes} mt-0" %>
            <%= form.submit "Set role", class: secondary_button_classes %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="rounded-xl border bg-white p-4">
      <h2 class="font-semibold">History</h2>
      <% if @actions.any? %>
        <ul class="divide-y"><%= render partial: "admin/shared/action", collection: @actions %></ul>
      <% else %>
        <p class="text-sm text-gray-500 mt-1">No actions yet.</p>
      <% end %>
    </div>
  </aside>
</div>
