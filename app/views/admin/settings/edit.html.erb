<% content_for :title, t(".title") %>
<section class="py-6">
  <%= render "admin/shared/tabs" %>
  <h1 class="mt-6 text-2xl font-bold"><%= t(".title") %></h1>
  <%= form_with model: @setting, url: admin_settings_path, method: :patch, class: "mt-4 space-y-4 md:w-1/2" do |form| %>
    <%= render "shared/errors", record: @setting %>
    <div>
      <%= form.label :commission_percent, class: "block text-sm font-medium" %>
      <%= form.number_field :commission_percent, min: 0, max: 50, required: true, class: "mt-1 block w-full rounded-lg border px-3 py-2" %>
      <p class="mt-1 text-xs text-gray-500"><%= t(".commission_hint") %></p>
    </div>
    <div>
      <%= form.label :min_balance, class: "block text-sm font-medium" %>
      <%= form.number_field :min_balance, max: 0, step: 100, required: true, class: "mt-1 block w-full rounded-lg border px-3 py-2" %>
      <p class="mt-1 text-xs text-gray-500"><%= t(".min_balance_hint") %></p>
    </div>
    <%= form.submit t(".save"), class: "rounded-lg bg-yellow-400 px-4 py-2 font-medium text-gray-900" %>
    <% if @setting.updated_by %>
      <p class="text-sm text-gray-600"><%= t("admin.tariffs.index.updated", name: @setting.updated_by.display_name, time: l(@setting.updated_at, format: :short)) %></p>
    <% end %>
  <% end %>
</section>
