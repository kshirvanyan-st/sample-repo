<% content_for :title, t(".title") %>
<section class="py-6">
  <%= render "admin/shared/tabs" %>
  <h1 class="mt-6 text-2xl font-bold"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-gray-600"><%= t(".intro") %></p>
  <div class="mt-4 grid gap-4 md:grid-cols-3">
    <%= render "summary", title: t(".today"), totals: @today %>
    <%= render "summary", title: t(".month"), totals: @month %>
    <div class="rounded-xl border p-4">
      <h2 class="font-semibold"><%= t(".balances") %></h2>
      <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
        <% @balances.each do |key, value| %>
          <dt class="text-gray-600"><%= t(".#{key}") %></dt>
          <dd class="text-right font-medium tabular-nums"><%= amd(value) %></dd>
        <% end %>
      </dl>
    </div>
  </div>
  <% if @debtors.any? %>
    <h2 class="mt-8 text-lg font-semibold"><%= t(".debtors") %></h2>
    <ul class="mt-2 divide-y rounded-xl border">
      <% @debtors.each do |driver| %>
        <li class="flex items-center justify-between p-3">
          <%= link_to driver.user.display_name, admin_driver_application_balance_path(driver), class: "underline" %>
          <span class="font-medium tabular-nums text-red-700"><%= amd(driver.balance) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
