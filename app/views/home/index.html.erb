<section class="text-center py-16">
  <h1 class="font-bold text-5xl text-pink-600">Spark</h1>
  <p class="mt-4 text-lg text-gray-600">Meet people nearby, match, chat and go live.</p>

  <div class="mt-8 flex justify-center gap-4">
    <% if authenticated? %>
      <p class="text-gray-700">Signed in as <strong><%= Current.user.email_address %></strong></p>
      <%= button_to "Sign out", session_path, method: :delete, class: "rounded-md px-3.5 py-2.5 bg-gray-200 hover:bg-gray-300 font-medium cursor-pointer" %>
    <% else %>
      <%= link_to "Sign up", new_registration_path, class: "rounded-md px-3.5 py-2.5 bg-pink-600 hover:bg-pink-500 text-white font-medium" %>
      <%= link_to "Sign in", new_session_path, class: "rounded-md px-3.5 py-2.5 bg-gray-200 hover:bg-gray-300 font-medium" %>
    <% end %>
  </div>
</section>
