<% if authenticated? %>
  <% profile = Current.user.profile %>
  <section class="py-8 flex flex-col md:flex-row gap-8 items-start">
    <%= render "profiles/card", profile: profile %>

    <div>
      <h1 class="font-bold text-3xl">Hi, <%= profile.display_name %>!</h1>
      <p class="text-gray-600 mt-2">
        <%= pluralize(Current.user.followers.count, "follower") %> · <%= Current.user.following.count %> following
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <%= link_to "Start discovering", discover_path, class: primary_button_classes %>
        <%= link_to "Edit profile", edit_my_profile_path, class: secondary_button_classes %>
        <%= link_to "My photos", photos_path, class: secondary_button_classes %>
      </div>
    </div>
  </section>
<% else %>
  <section class="text-center py-16">
    <h1 class="font-bold text-5xl text-pink-600">Spark</h1>
    <p class="mt-4 text-lg text-gray-600">Meet people nearby, match, chat and go live.</p>

    <div class="mt-8 flex justify-center gap-4">
      <%= link_to "Sign up", new_registration_path, class: primary_button_classes %>
      <%= link_to "Sign in", new_session_path, class: secondary_button_classes %>
    </div>
  </section>
<% end %>
