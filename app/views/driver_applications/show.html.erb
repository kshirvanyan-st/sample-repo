<% content_for :title, t(".title") %>
<section class="mx-auto max-w-lg py-10">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <div class="mt-6 rounded-xl border p-5">
    <p class="text-sm text-gray-600"><%= t(".status") %></p>
    <p class="mt-1 text-xl font-semibold"><%= t("driver_profiles.statuses.#{@driver_profile.status}") %></p>
    <p class="mt-2 text-gray-700"><%= t(".explain.#{@driver_profile.status}") %></p>
    <% if @driver_profile.review_note.present? && !@driver_profile.approved? %>
      <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-amber-900"><%= @driver_profile.review_note %></p>
    <% end %>
  </div>

  <% if (vehicle = @driver_profile.vehicle) && vehicle.plate_number.present? %>
    <div class="mt-4 rounded-xl border p-5">
      <p class="font-medium"><%= vehicle.description %></p>
      <p class="mt-1 text-gray-600"><%= vehicle.plate_number %> · <%= t("vehicles.classes.#{vehicle.vehicle_class}") %></p>
    </div>
  <% end %>

  <% if @driver_profile.editable? %>
    <%= link_to t(".edit"), edit_driver_application_path, class: "mt-6 inline-block rounded-lg bg-yellow-400 px-4 py-2 font-semibold text-gray-900" %>
  <% end %>
</section>
