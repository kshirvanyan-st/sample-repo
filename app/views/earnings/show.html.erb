<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Earnings</h1>
  <p class="text-gray-600 mt-1">Coins people gifted you during your streams.</p>

  <div class="mt-6 rounded-xl border bg-white p-6">
    <p class="text-sm text-gray-500">Total earned</p>
    <p class="text-4xl font-bold mt-1">🪙 <%= Current.user.earnings_balance %></p>
    <p class="text-sm text-gray-500 mt-3">Cashing out is coming soon.</p>
  </div>

  <% if @by_stream.any? %>
    <h2 class="font-semibold text-xl mt-8">Top streams</h2>
    <ul class="mt-3 divide-y border rounded-xl bg-white">
      <% @by_stream.each do |(stream_id, title), coins| %>
        <li class="flex justify-between p-3 text-sm"><%= link_to title, studio_stream_path(stream_id), class: "underline" %><span class="font-medium">🪙 <%= coins %></span></li>
      <% end %>
    </ul>
  <% end %>

  <h2 class="font-semibold text-xl mt-8">Recent gifts</h2>
  <% if @gifts.any? %>
    <ul class="mt-3 divide-y border rounded-xl bg-white">
      <% @gifts.each do |gift_transaction| %>
        <li class="flex justify-between p-3 text-sm">
          <span><%= gift_transaction.gift.emoji %> <strong><%= gift_transaction.sender.profile.display_name %></strong> sent <%= gift_transaction.gift.name %>
            <span class="text-gray-400 ml-2"><%= time_ago_in_words(gift_transaction.created_at) %> ago</span></span>
          <span class="font-medium text-green-700">+<%= gift_transaction.coins %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 mt-2">No gifts yet. <%= link_to "Go live", go_live_path, class: "underline" %> and they'll show up here.</p>
  <% end %>
</div>
