<% if profile %>
  <div id="<%= dom_id(profile, :deck) %>" data-controller="swipe" data-action="keydown@window->swipe#key" class="select-none">
    <div data-swipe-target="card" class="rounded-2xl overflow-hidden shadow-lg bg-white touch-none cursor-grab transition-transform"
         data-action="pointerdown->swipe#start pointermove->swipe#move pointerup->swipe#end pointercancel->swipe#cancel">
      <% if (photo = profile.main_photo) %>
        <%= image_tag photo.image.variant(:card), alt: profile.display_name, draggable: false, class: "w-full aspect-[3/4] object-cover pointer-events-none" %>
      <% end %>
      <div class="p-4">
        <p class="font-bold text-2xl"><%= profile.display_name %>, <%= profile.age %></p>
        <p class="text-sm text-gray-500"><%= [ profile.city.presence, distance_label(profile) ].compact.join(" · ") %></p>
        <% if profile.bio.present? %><p class="mt-2 text-gray-700 line-clamp-3"><%= profile.bio %></p><% end %>
        <%= link_to "View profile", profile_path(profile), class: "text-sm underline text-gray-600 mt-2 inline-block", data: { turbo_frame: "_top" } %>
      </div>
    </div>

    <div class="flex justify-center gap-4 mt-6">
      <%= render "discover/rate_button", profile: profile, kind: "skip", label: "Skip", classes: secondary_button_classes %>
      <%= render "discover/rate_button", profile: profile, kind: "superlike", label: "★ Super like", classes: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <%= render "discover/rate_button", profile: profile, kind: "like", label: "♥ Like", classes: primary_button_classes %>
    </div>
    <p class="text-center text-xs text-gray-400 mt-3">Drag the card or use ← / → to skip or like</p>
  </div>
<% else %>
  <div class="text-center py-16">
    <h2 class="font-bold text-2xl">That's everyone for now</h2>
    <p class="text-gray-600 mt-2">Try widening your age range or distance.</p>
    <%= link_to "Discovery settings", edit_my_profile_path(anchor: "discovery"), class: "#{primary_button_classes} inline-block mt-6", data: { turbo_frame: "_top" } %>
  </div>
<% end %>
