<div class="mx-auto md:w-2/3 w-full">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="font-bold text-4xl"><%= @profile.display_name %>, <%= @profile.age %></h1>
      <p class="text-gray-500 mt-1"><%= [ @profile.gender.humanize, @profile.city.presence ].compact.join(" · ") %></p>
    </div>

    <% if @profile.user == Current.user %>
      <%= link_to "Edit profile", edit_my_profile_path, class: secondary_button_classes %>
    <% else %>
      <%= render "profiles/follow", profile: @profile unless Current.user.blocking?(@profile.user) %>
    <% end %>
  </div>

  <% if (live = @profile.user.live_stream) %>
    <%= link_to stream_path(live), class: "mt-4 inline-flex items-center gap-2 rounded-lg bg-red-50 px-3 py-2 text-red-700 font-medium" do %>
      <%= live_badge %> Live now: <%= live.title %>
    <% end %>
  <% end %>

  <% if @profile.bio.present? %>
    <p class="mt-6 whitespace-pre-line"><%= @profile.bio %></p>
  <% end %>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-6">
    <% @photos.each do |photo| %>
      <%= image_tag photo.image.variant(:card), alt: @profile.display_name, class: "rounded-lg w-full aspect-[3/4] object-cover" %>
    <% end %>
  </div>

  <% unless @profile.user == Current.user %>
    <div class="flex gap-4 mt-8 text-sm text-gray-500">
      <% if Current.user.blocking?(@profile.user) %>
        <%= button_to "Unblock", profile_block_path(@profile), method: :delete, class: "underline cursor-pointer" %>
      <% else %>
        <%= button_to "Block", profile_block_path(@profile), class: "underline cursor-pointer", form: { data: { turbo_confirm: "Block #{@profile.display_name}? You won't see each other anymore." } } %>
      <% end %>
      <%= link_to "Report", new_profile_report_path(@profile), class: "underline" %>
    </div>
  <% end %>
</div>
