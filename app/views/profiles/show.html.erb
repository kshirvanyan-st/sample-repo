<div class="mx-auto md:w-2/3 w-full">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="font-bold text-4xl"><%= @profile.display_name %>, <%= @profile.age %></h1>
      <p class="text-gray-500 mt-1"><%= [ @profile.gender.humanize, @profile.city.presence ].compact.join(" · ") %></p>
    </div>

    <% if @profile.user == Current.user %>
      <%= link_to "Edit profile", edit_my_profile_path, class: secondary_button_classes %>
    <% else %>
      <%= render "profiles/follow", profile: @profile %>
    <% end %>
  </div>

  <% if @profile.bio.present? %>
    <p class="mt-6 whitespace-pre-line"><%= @profile.bio %></p>
  <% end %>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-6">
    <% @photos.each do |photo| %>
      <%= image_tag photo.image.variant(:card), alt: @profile.display_name, class: "rounded-lg w-full aspect-[3/4] object-cover" %>
    <% end %>
  </div>
</div>
