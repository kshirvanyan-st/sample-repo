    "Lava + water = stone. Make stone in the cup.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava + agua = piedra. Haz piedra en el vaso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lave + eau = pierre. Fais de la pierre dans le gobelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava + Wasser = Stein. Mach Stein im Becher."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava + água = pedra. Faça pedra no copo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "溶岩 + 水 = 石。カップの中で石を作ろう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용암 + 물 = 돌. 컵 안에서 돌을 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "岩浆 + 水 = 石头。在杯子里造出石头。"
          }
        }
      }
    },
