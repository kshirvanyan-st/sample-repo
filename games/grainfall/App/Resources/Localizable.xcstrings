    "Drains swallow anything. Feed them the lava.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los desagües se tragan todo. Dales la lava."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les siphons avalent tout. Donne-leur la lave."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abflüsse schlucken alles. Füttere sie mit Lava."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ralos engolem tudo. Alimente-os com a lava."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "排水口は何でも吸いこむ。溶岩を流しこもう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배수구는 뭐든 삼켜요. 용암을 먹이세요."
