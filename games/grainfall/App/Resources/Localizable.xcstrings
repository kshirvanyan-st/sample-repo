    "Lava ruins the pot. Dig around it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lava arruina el vaso. Cava alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lave gâche le gobelet. Creuse autour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava ruiniert den Becher. Grabe drumherum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lava estraga o copo. Cave em volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "溶岩はカップをだめにする。よけて掘ろう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용암은 컵을 망쳐요. 피해서 파세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "岩浆会毁掉杯子，绕开它挖。"
          }
        }
      }
    },
    "Lava sets plants on fire": {
