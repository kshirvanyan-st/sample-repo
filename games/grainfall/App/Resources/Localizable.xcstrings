    "%@ got into the cup.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha caído en el vaso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du %@ est tombé dans le pot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist in den Becher geraten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caiu no pote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がカップに入ってしまった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 컵에 들어갔어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 掉进了杯子里。"
          }
        }
      }
    },
