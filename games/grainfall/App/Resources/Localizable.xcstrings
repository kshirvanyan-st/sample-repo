    "Blasts break stone. Lava burns plants.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bombas rompen la piedra. La lava quema las plantas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bombes brisent la pierre. La lave brûle les plantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bomben sprengen Stein. Lava verbrennt Pflanzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bombas quebram pedra. Lava queima plantas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "爆弾は石をこわす。溶岩は植物を燃やす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭탄은 돌을 부숴요. 용암은 식물을 태워요."
