        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭탄 하나하나가 소중해요. 돌에 쓰세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每颗炸弹都很宝贵，留着炸石头。"
          }
        }
      }
    },
    "Empty the lava into the drain before you dig to the cup.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía la lava en el desagüe antes de cavar hasta el vaso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide la lave dans le siphon avant de creuser jusqu'au gobelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leite die Lava in den Abfluss, bevor du zum Becher gräbst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Despeje a lava no ralo antes de cavar até o copo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カップまで掘る前に、溶岩を排水口に流そう。"
