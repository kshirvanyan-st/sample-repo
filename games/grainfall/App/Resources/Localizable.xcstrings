    "Water + lava = stone. Fill the cup with stone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agua + lava = piedra. Llena el vaso de piedra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eau + lave = pierre. Remplis le gobelet de pierre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasser + Lava = Stein. Fülle den Becher mit Stein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Água + lava = pedra. Encha o copo de pedra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水 + 溶岩 = 石。カップを石で満たそう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 + 용암 = 돌. 컵을 돌로 채우세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水 + 岩浆 = 石头。用石头填满杯子。"
          }
        }
      }
    },
    "Water cools lava into a stone crust.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agua enfría la lava y forma una costra de piedra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eau refroidit la lave en croûte de pierre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasser kühlt Lava zu einer Steinkruste ab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A água esfria a lava e forma uma crosta de pedra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水で冷えた溶岩は石の殻になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물이 용암을 식혀 돌 껍질을 만들어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水会把岩浆冷却成一层石壳。"
          }
        }
      }
    },
    "Water flows sideways. Sand doesn't.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agua fluye de lado. La arena no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eau coule sur les côtés. Pas le sable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasser fließt seitwärts. Sand nicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A água escorre para os lados. A areia, não."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水は横に流れる。砂は流れない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물은 옆으로 흘러요. 모래는 아니에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水会横向流动，沙子不会。"
          }
        }
      }
    },
    "Water the seeds and the garden grows": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega las semillas y el jardín crecerá"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrose les graines et le jardin poussera"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gieß die Samen, dann wächst der Garten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regue as sementes e o jardim cresce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種に水をやれば庭が育つ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "씨앗에 물을 주면 정원이 자라요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给种子浇水，花园就会长起来"
          }
        }
      }
    },
