    "Plants drink water and grow. Fill the pot with green.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas beben agua y crecen. Llena el vaso de verde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes boivent l'eau et poussent. Remplis le gobelet de vert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pflanzen trinken Wasser und wachsen. Fülle den Becher mit Grün."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas bebem água e crescem. Encha o copo de verde."
